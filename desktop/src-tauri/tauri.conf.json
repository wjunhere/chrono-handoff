{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chrono-handoff",
  "version": "0.1.0",
  "identifier": "dev.chrono.handoff",
  "build": {
    "frontendDist": "../../src/chrono_handoff/statics"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "untrusted comment: minisign public key: F97ECAAAA5BAAD1A\nRWQarbqlqsp++RWSdkUjLGxa55q2h/xEhuTVVcPFToQRYKMTU2LTxIlg",
      "endpoints": [
        "https://github.com/wjunhere/chrono-handoff/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/chrono-core"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
