# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
*.egg

# --- 虚拟环境 ---------------------------------------------------------------
.venv/
venv/
env/

# --- 运行时产物（never commit these）---------------------------------------
# logs/      每次 cue / run 的 JSONL 事件日志与截图
# *_home/    测试用的 CHRONO_HOME（含校准数据与设置）
# logs/_td/  GUI 冒烟测试的子进程结果
logs/
shots/
*.jsonl
logs/_home/

# --- 本地配置 ---------------------------------------------------------------
# 用户自己的面板设置与校准数据不应进仓库；仓库只带默认值
settings.json
calibration.json
daemon.json

# --- 编辑器 / 系统 ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- pi agent 运行时（本机生成的 agent 网络配置）-----------------------------
.pi/

# --- 临时 -------------------------------------------------------------------
*.tmp
*.bak
# One-off scratch scripts the agent drops at the repo root.  Scoped to the
# root on purpose: an unscoped `_*.py` also swallows real shared helpers such
# as scripts/_wininput.py.
/_*.py
